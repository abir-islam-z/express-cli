# Node.js will not type-strip .ts files inside node_modules.
# Publish the compiled dist entrypoint; run src directly only from a checkout.
src/
tsconfig.json
eslint.config.mjs

# Development files
*.log
logs/
dist/logs/
node_modules/
.git/
.gitignore

# Lock files
package-lock.json
bun.lockb

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Test files
test/
tests/
__tests__/
*.test.js
*.test.ts
*.spec.js
*.spec.ts

# Documentation (keep README.md)
docs/

# Build artifacts
*.map
*.tsbuildinfo

# Temporary files
*.tmp
*.temp
