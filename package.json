{
  "name": "express-modular-cli",
  "version": "3.0.0",
  "description": "Generate modular Express.js projects that run TypeScript directly on Node.js",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "exm-cli": "dist/index.js"
  },
  "scripts": {
    "dev": "node src/index.ts",
    "start": "node src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "node src/index.ts --help",
    "prepare": "tsc"
  },
  "dependencies": {
    "commander": "^9.4.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "express",
    "cli",
    "generator",
    "typescript",
    "modular",
    "scaffolding"
  ],
  "author": "https://github.com/abir-islam-z",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/abir-islam-z/express-cli"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
