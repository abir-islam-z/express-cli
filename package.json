{
  "name": "express-modular-cli",
  "version": "3.1.0",
  "description": "Zero-dependency CLI that generates modular Express.js projects",
  "homepage": "https://abir-islam-z.github.io/express-cli/",
  "bugs": {
    "url": "https://github.com/abir-islam-z/express-cli/issues"
  },
  "type": "module",
  "bin": {
